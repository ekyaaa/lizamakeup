    <script is:inline>
        // Generate Dynamic Favicon
        function generateFavicon() {
            const canvas = document.createElement('canvas');
            canvas.width = 64;
            canvas.height = 64;
            const ctx = canvas.getContext('2d');
            
            // Wait for Playfair Display to load
            document.fonts.load('italic 50px "Playfair Display"').then(() => {
                ctx.clearRect(0, 0, 64, 64);
                ctx.font = 'italic 56px "Playfair Display"';
                ctx.fillStyle = '#d4af37';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('L', 32, 36);
                
                const link = document.getElementById('dynamic-favicon');
                if (link) link.href = canvas.toDataURL('image/png');
            });
        }
        
        // Try generating on load and after a short delay to ensure font availability
        window.addEventListener('DOMContentLoaded', generateFavicon);
        setTimeout(generateFavicon, 2000);
    </script>
