    <script>
        import { initAnimations } from '../scripts/animations.js';
        
        // Wait for DOM to be fully ready
        document.addEventListener('DOMContentLoaded', () => {
            initAnimations();

            // Mobile Menu Logic
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');
            const mobileExtra = document.querySelector('.mobile-extra');
            let isMenuOpen = false;

            function toggleMenu() {
                isMenuOpen = !isMenuOpen;
                mobileMenuBtn.classList.toggle('active');
                
                if (isMenuOpen) {
                    mobileMenu.classList.add('active');
                    mobileMenu.style.opacity = '1';
                    mobileMenu.style.pointerEvents = 'auto';
                    document.body.style.overflow = 'hidden'; // Prevent scroll
                    
                    // Trigger link animations
                    mobileLinks.forEach(link => {
                        link.style.opacity = '1';
                        link.style.transform = 'translateY(0)';
                    });
                    if (mobileExtra) {
                        mobileExtra.style.opacity = '1';
                        mobileExtra.style.transform = 'translateY(0)';
                    }
                } else {
                    mobileMenu.classList.remove('active');
                    mobileMenu.style.opacity = '0';
                    mobileMenu.style.pointerEvents = 'none';
                    document.body.style.overflow = ''; // Restore scroll
                    
                    // Reset link animations
                    mobileLinks.forEach(link => {
                        link.style.opacity = '0';
                        link.style.transform = 'translateY(2rem)';
                    });
                    if (mobileExtra) {
                        mobileExtra.style.opacity = '0';
                        mobileExtra.style.transform = 'translateY(2rem)';
                    }
                }
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', toggleMenu);
            }

            // Close menu when link is clicked
            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    if (isMenuOpen) toggleMenu();
                });
            });
        });
    </script>
